{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureOpenAI": {
    "Endpoint": "",
    "ChatDeployment": "chat",
    "EmbeddingDeployment": "embeddings",
    "Temperature": 0.2,
    "MaxOutputTokens": 1000
  },
  "Knowledge": {
    "FolderPath": "../../knowledge",
    "TopK": 5,
    "MaxDistance": 0.7,
    "IngestOnStartup": false
  },
  "OpsApi": {
    "BaseUrl": "http://localhost:5101/"
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  }
}
